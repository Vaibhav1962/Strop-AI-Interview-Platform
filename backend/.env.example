DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewiq
CORS_ORIGINS=["http://localhost:5173"]

# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# AI Provider Keys
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
# Groq: fast free-tier open models (Llama / Qwen). Tried first for the interviewer.
GROQ_API_KEY=
# Optional second Groq key (another account): used when the first hits its rate limit
GROQ2_API_KEY=
# "development" or "production". Production hides /docs and enforces strict settings checks.
ENVIRONMENT=development
# Only true behind a reverse proxy you control (it makes X-Forwarded-For trusted for rate limiting).
TRUST_PROXY_HEADERS=false
