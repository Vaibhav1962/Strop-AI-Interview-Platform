# Required for `docker compose up --build`. Copy to .env and fill in real
# values — generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# (SECRET_KEY specifically wants: python -c "import secrets; print(secrets.token_hex(32))")
#
# These are never committed (.env is gitignored) — do not put real values
# in this file.

APP_DB_PASSWORD=
SECRET_KEY=
JUDGE0_DB_PASSWORD=
JUDGE0_REDIS_PASSWORD=
JUDGE0_AUTH_TOKEN=

# AI Provider Keys (for voice TTS, speech STT, and interview LLM responses)
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
# Groq: fast free-tier open models (Llama / Qwen). Tried first for the interviewer.
GROQ_API_KEY=
# Optional second Groq key (another account): used when the first hits its rate limit
GROQ2_API_KEY=

# "development" or "production" (production hides /docs and enforces strict settings checks)
ENVIRONMENT=development
# Comma-free JSON list of allowed frontend origins; never "*"
# CORS_ORIGINS=["https://your-frontend.example"]
# Only true behind a reverse proxy you control
TRUST_PROXY_HEADERS=false
